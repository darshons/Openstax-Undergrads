# Copy to BackEnd/backend.env (loaded by main.py via python-dotenv).
# ALL keys below are OPTIONAL — the backend boots and generates scripts
# without any API keys by using the "local" provider (Claude Code CLI).

# Optional: enables model_choice="anthropic" (direct Anthropic API).
# When unset, "anthropic" requests transparently fall back to "local",
# which shells out to the `claude` CLI (~/.local/bin/claude) using the
# machine's ~/.claude credentials.
#ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables model_choice="gemini" and the image-generation endpoints.
#GEMINI_API_KEY=...

# Optional overrides for the local provider
#CLAUDE_CLI_MODEL=sonnet
#CLAUDE_CLI_TIMEOUT_SECONDS=900

# Optional: where Manim pipeline runs are written (defaults to <repo>/output/manim_runs)
#MANIM_OUTPUT_ROOT=/absolute/path/to/output/manim_runs
